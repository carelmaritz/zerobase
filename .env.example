# Copy to .env and fill in the two required secrets.

# Required. Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Required. Signs login sessions. Generate with:  openssl rand -hex 32
ZEROBASE_SECRET_KEY=

# The first account can always be created. Set true to let more people sign up.
ZEROBASE_ALLOW_REGISTRATION=false

# Shown in front of amounts.
ZEROBASE_CURRENCY_SYMBOL=£

# Published port (and interface) for the app container.
ZEROBASE_PORT=8000
ZEROBASE_BIND=127.0.0.1

# Using the Caddy proxy profile (HTTPS)? Set your hostname and mark cookies as secure.
# ZEROBASE_DOMAIN=budget.example.com
# ZEROBASE_HTTPS_ONLY=true
